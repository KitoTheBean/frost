"VertexLitGeneric"
{
	"$basetexture" 	"models\scp\ert\qrf_Equip_bm"

	"$bumpmap" 	"models\scp\ert\Equip_nm"

	$halflambert 1
	$nocull 1
	
	$detail		"models\scp\ert\shared\detail_plastic"
